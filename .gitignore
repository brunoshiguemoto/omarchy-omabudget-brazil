# ==============================================================================
# .gitignore - omarchy-omabudget-brazil
# Configurado para Go, Qt/QML e pacotes do Arch Linux / Omarchy
# ==============================================================================

# Executáveis e Binários de Build em Go
bin/
omabudget
*.exe
*.exe.manifest
*.dll
*.so
*.dylib
*.test
*.out

# Arquivos de Teste e Cobertura
*.cover
*.mo
*.pot

# Dependências Go (se vendor for usado)
# vendor/

# Arquivos Temporários de Sistema e IDEs
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
.clang-format

# Qt / QML Cache e Compilação
*.qmlc
*.jsc
.qmake.stash
Makefile.Debug
Makefile.Release

# Arch Linux / Omarchy Packaging (makepkg)
pkg/
src/
*.pkg.tar.zst
*.pkg.tar.xz
*.log

# Banco de Dados Local de Testes (Não enviar dados financeiros para o Git)
*.db
*.sqlite
*.sqlite3
ledger.db
~/.config/omabudget/ledger.db
